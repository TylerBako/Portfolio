---
import { contact, profile } from '../data/content';

// Only what the script needs.
const config = { key: contact.web3formsKey, subject: contact.subject, to: profile.email };
---

<dialog class="contact modal" aria-labelledby="contact-title">
  <form class="panel" novalidate data-contact-form>
    <div class="header">
      <h2 id="contact-title">Say hello</h2>
      <button type="button" class="btn btn-secondary" data-contact-close>Close</button>
    </div>

    <div class="fields" data-contact-fields>
      <div class="field">
        <label for="contact-name">Name</label>
        <input class="input" id="contact-name" name="name" autocomplete="name" required autofocus />
      </div>
      <div class="field">
        <label for="contact-email">Email</label>
        <input class="input" id="contact-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="contact-message">Message</label>
        <textarea class="input" id="contact-message" name="message" rows="7" required></textarea>
      </div>
      <!-- Honeypot: hidden from people, filled in by bots; Web3Forms drops those submissions. -->
      <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </div>

    <p class="status" data-contact-status role="status" aria-live="polite"></p>

    <div class="actions" data-contact-actions>
      <button type="submit" class="btn btn-primary" data-contact-submit>Send</button>
    </div>
  </form>
</dialog>

<script type="application/json" id="contact-config" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />

<script>
  import { closeOnBackdropClick } from '../scripts/modal';

  interface Config { key: string; subject: string; to: string }

  const dialog = document.querySelector<HTMLDialogElement>('dialog.contact')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-contact-form]')!;
  const fields = dialog.querySelector<HTMLElement>('[data-contact-fields]')!;
  const status = dialog.querySelector<HTMLElement>('[data-contact-status]')!;
  const submit = dialog.querySelector<HTMLButtonElement>('[data-contact-submit]')!;
  const actions = dialog.querySelector<HTMLElement>('[data-contact-actions]')!;
  const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-contact-close]')!;
  const inputs = fields.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.input');
  const config: Config = JSON.parse(document.getElementById('contact-config')!.textContent!);

  function setStatus(text: string, tone: 'info' | 'error' | 'success' = 'info') {
    status.textContent = text;
    status.dataset.tone = tone;
  }

  // True while a Web3Forms request is in flight, so reopening the dialog doesn't wipe it.
  let sending = false;

  function reset() {
    form.reset();
    fields.hidden = false;
    actions.hidden = false;
    submit.disabled = false;
    submit.textContent = 'Send';
    setStatus('');
  }

  // "Say hello" links keep their mailto: href, so they still work without JavaScript.
  document.querySelectorAll<HTMLAnchorElement>('[data-contact-open]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      if (!dialog.open && !sending) reset();
      dialog.showModal();
    });
  });

  closeBtn.addEventListener('click', () => dialog.close());
  closeOnBackdropClick(dialog);

  function openEmailApp(name: string, email: string, message: string) {
    const params = new URLSearchParams({
      subject: `${config.subject} (${name})`,
      body: `${message}\n\n— ${name} <${email}>`,
    });
    // URLSearchParams encodes spaces as "+", which mail apps show literally.
    window.location.href = `mailto:${config.to}?${params.toString().replace(/\+/g, '%20')}`;
    setStatus(`Your email app should open with the message filled in. If nothing opened, email me at ${config.to}.`);
  }

  async function sendWithWeb3Forms(data: FormData) {
    data.append('access_key', config.key);
    data.append('subject', config.subject);
    data.append('from_name', String(data.get('name')));
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: data,
    });
    const json = (await res.json().catch(() => null)) as { success?: boolean } | null;
    if (!res.ok || !json?.success) throw new Error(`Web3Forms responded ${res.status}`);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    // Trim first so whitespace-only input fails `required`.
    inputs.forEach((input) => { input.value = input.value.trim(); });
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const name = String(data.get('name'));
    const email = String(data.get('email'));
    const message = String(data.get('message'));

    if (!config.key) {
      openEmailApp(name, email, message);
      return;
    }

    sending = true;
    submit.disabled = true;
    submit.textContent = 'Sending…';
    setStatus('');
    try {
      await sendWithWeb3Forms(data);
      fields.hidden = true;
      actions.hidden = true;
      setStatus(`Thanks, ${name}. Your message is on its way and I’ll reply to ${email}.`, 'success');
      // The focused Send button is now hidden; give focus somewhere sensible.
      if (dialog.open) closeBtn.focus();
    } catch {
      submit.disabled = false;
      submit.textContent = 'Send';
      status.replaceChildren(
        'Something went wrong sending that. You can ',
        Object.assign(document.createElement('a'), { href: `mailto:${config.to}`, textContent: 'email me directly' }),
        ' instead.',
      );
      status.dataset.tone = 'error';
    } finally {
      sending = false;
    }
  });
</script>

<style>
  .panel {
    width: min(560px, 100%);
    margin-block: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  h2 {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: normal;
  }
  .fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* Nocturne's .field label is 12px; the form reads better a step up. */
  .field > label { font-size: 13px; }
  textarea.input {
    min-height: 160px;
    max-height: 50vh;
    line-height: 1.55;
  }
  .status {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-78);
  }
  /* Stay rendered (live regions that appear with their text often go unannounced);
     cancel the panel's 20px gap so an empty status takes no space. */
  .status:empty { margin-top: -20px; }
  .status[data-tone='success'] { color: var(--color-accent-300); font-size: 16px; }
  .status[data-tone='error'] { color: var(--color-accent-200); }
  .actions {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 560px) {
    .panel { padding: 20px; }
  }
</style>
