---
interface Props {
  id?: string;
  text: string;
}

const { id, text } = Astro.props;
---

<h2 class="section-label" id={id}>
  <span class="line" aria-hidden="true"></span>
  {text}
</h2>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.55;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    scroll-margin-top: 24px;
  }
  .line {
    width: 44px;
    height: 1px;
    flex: none;
    background: var(--color-accent);
  }
</style>
